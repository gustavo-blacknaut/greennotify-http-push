<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. A apiKey fica fora do backup na nuvem; a transferência direta entre aparelhos continua levando a configuração. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="greennotify_prefs.xml" />
    </cloud-backup>
</data-extraction-rules>
