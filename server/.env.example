# Copie para .env (na mesma pasta do index.js) ou defina como variáveis de ambiente.
# Variáveis de ambiente têm prioridade sobre o arquivo.

# Obrigatória, mínimo 16 caracteres. Autoriza cadastrar dispositivos em POST /register.
ADMIN_KEY=

# Porta HTTP. No Pterodactyl não precisa: o servidor usa SERVER_PORT, que o painel já define.
# PORT=8080
